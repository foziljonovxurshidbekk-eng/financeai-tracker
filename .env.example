# AI kaliti — ovozli/matnli kiritish tahlili va chat uchun. Ikkisidan biri yetarli.
# Gemini (bepul, karta kerak emas): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# yoki Claude (pullik): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Bo'sh qolsa, ilova offline rejimda ishlaydi (oddiy kalit so'zlar bo'yicha tahlil, chat o'chiq).

# Ixtiyoriy: Postgres (Neon/Render). Berilsa, ma'lumotlar faylda emas, bazada saqlanadi
DATABASE_URL=

# Ixtiyoriy: saytga kirish paroli (internetga chiqarsangiz albatta qo'ying)
APP_PASSWORD=

# Ixtiyoriy: Telegram bot (@BotFather'dan token oling)
BOT_TOKEN=
# Botdan foydalanishga ruxsat berilgan Telegram ID'lar (vergul bilan). ID'ni bilish uchun botga /start yozing.
TELEGRAM_ALLOWED_IDS=

# Ixtiyoriy: bot webhook manzili (Render'da avtomatik aniqlanadi)
# WEBHOOK_URL=https://sizning-sayt.com

# Ixtiyoriy
PORT=3000
# DATA_DIR=./data
# GEMINI_MODEL=gemini-flash-latest
# CLAUDE_MODEL=claude-opus-5-5
# AI_PROVIDER=gemini   # ikkala kalit bo'lsa, qaysi biri ishlatilsin
